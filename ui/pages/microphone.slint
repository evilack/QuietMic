// 입력 장치 선택, 입력/출력 레벨, 처리 시작/중지를 모아 보여 주는 마이크 페이지다.
import { ComboBox, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Label, Muted, Action, Meter, Card } from "../components/controls.slint";

import { Control, ParameterId } from "../types.slint";
import { Translations } from "../localization.slint";
import { ParameterRow } from "../components/parameter-row.slint";

export component MicrophonePage inherits VerticalLayout {
    in property <Translations> translations;
    in property <Control> gain-control;
    callback parameter(ParameterId, float);
    in property <[string]> inputs;
    // 선택 행은 루트와 양방향 연결된다. 장치 ID 변환은 컨트롤러의 DeviceCatalog가 담당한다.
    in-out property <int> input-index: -1;
    in property <bool> running;
    in property <bool> busy;
    in property <string> output-name;
    in property <float> input-level;
    in property <float> output-level;
    in property <int> vad;
    in property <string> performance;
    // 페이지는 장치를 직접 열지 않고 선택/새로고침/처리 요청을 상위 컴포넌트로 전달한다.
    callback select-input(int);
    callback show-settings;
    callback refresh;
    callback start-stop;

    spacing: 12px;
    ScrollView {
        content-width: self.width;
        VerticalLayout {
            padding-right: 12px;
            spacing: 18px;
            Card {
                VerticalLayout {
                    padding: Theme.card-padding;
                    spacing: 16px;
                    Label { text: root.translations.microphone-input-title; font-weight: 600; }
                    ComboBox {
                        // 표시할 이름 목록과 선택 행을 연결한다. 엔진 실행/시작/설치 중에는 선택을 막는다.
                        model: root.inputs;
                        current-index <=> root.input-index;
                        enabled: !root.running && !root.busy;
                        // 선택된 표시 문자열 대신 current-index를 전달한다. 같은 이름의 장치가 있어도 현재 목록의 행을 구분할 수 있다.
                        selected(value) => { root.select-input(self.current-index); }
                    }
                    // 입력/출력 미터는 C++에서 주기적으로 전달한 표시용 레벨을 사용한다.
                    Meter { value: root.input-level; }
                    Muted { text: root.translations.microphone-input-help; }
                }
            }
            Card {
                VerticalLayout {
                    padding: Theme.card-padding;
                    spacing: 16px;
                    Label { text: root.translations.microphone-output-title; font-weight: 600; }
                    // 가상 출력은 이름을 안내하고, 준비 작업은 앱 설정 페이지로 이동해 요청한다.
                    Label { text: root.output-name; font-size: 21px; color: Theme.accent; }
                    Meter { value: root.output-level; }
                    // 필터 페이지와 같은 설정 모델 및 변경 콜백을 사용한다.
                    ParameterRow {
                        control: root.gain-control;
                        translations: root.translations;
                        changed(id, value) => { root.parameter(id, value); }
                    }
                    Muted { text: root.translations.microphone-output-help; wrap: word-wrap; }
                    Action { text: root.translations.microphone-output-setup; clicked => { root.show-settings(); } }
                }
            }
            HorizontalLayout {
                height: 36px;
                Muted { text: root.translations.microphone-vad + "  " + root.vad + "%"; vertical-alignment: center; }
                Muted { text: root.performance; horizontal-alignment: right; vertical-alignment: center; }
            }
        }
    }
    // 시작/중지 버튼은 스크롤 밖에 두어 작은 창에서도 항상 접근할 수 있다.
    HorizontalLayout {
        height: 44px;
        spacing: 12px;
        Action { text: root.translations.microphone-refresh; enabled: !root.running && !root.busy; clicked => { root.refresh(); } }
        Action {
            // 연결 작업 중/실행 중/정지 상태에 따라 문구를 고른다. busy 중 클릭을 막고 나머지는 같은 start-stop 요청을 보낸다.
            text: root.busy ? root.translations.microphone-connecting : root.running ? root.translations.microphone-stop : root.translations.microphone-start;
            primary: true;
            enabled: !root.busy;
            clicked => { root.start-stop(); }
        }
    }
}
