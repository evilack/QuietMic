// 설정 하나를 제목/설명/수치/슬라이더로 보여 주는 재사용 행. 숫자 정의와 한글 표시 문구의 책임을 분리한다.
import { Slider } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Control, ParameterId } from "../types.slint";
import { Translations } from "../localization.slint";
import { Label, Muted } from "controls.slint";

// Presentation belongs to the UI; numeric values and limits come from configuration.
// 화면에만 필요한 제목/설명/단위를 묶는다. 실제 설정 값과 범위는 C++가 주는 Control에 들어 있다.
struct ParameterText { label: string, detail: string, unit: string }
global ParameterResources {
    // ID를 표시 문구로 매핑하는 순수 함수다. 상태를 변경하지 않으므로 바인딩에서 안전하게 사용한다.
    public pure function describe(id: ParameterId, copy: Translations) -> ParameterText {
        if id == ParameterId.dry-mix { return { label: copy.parameter-dry-label, detail: copy.parameter-dry-detail, unit: "%" }; }
        if id == ParameterId.highpass-cutoff { return { label: copy.parameter-cutoff-label, detail: copy.parameter-cutoff-detail, unit: "Hz" }; }
        if id == ParameterId.voice-threshold { return { label: copy.parameter-threshold-label, detail: copy.parameter-threshold-detail, unit: "%" }; }
        if id == ParameterId.reduction { return { label: copy.parameter-reduction-label, detail: copy.parameter-reduction-detail, unit: "dB" }; }
        if id == ParameterId.hold { return { label: copy.parameter-hold-label, detail: copy.parameter-hold-detail, unit: "ms" }; }
        if id == ParameterId.release { return { label: copy.parameter-release-label, detail: copy.parameter-release-detail, unit: "ms" }; }
        if id == ParameterId.attack { return { label: copy.parameter-attack-label, detail: copy.parameter-attack-detail, unit: "ms" }; }
        // 위에서 처리한 나머지 파라미터가 아니면 출력 볼륨 보정 문구를 사용한다. 현재 열거형에서 gain에 해당한다.
        return { label: copy.parameter-gain-label, detail: copy.parameter-gain-detail, unit: "dB" };
    }
}

// 하나의 Control 모델과 활성 여부를 받아 같은 레이아웃으로 모든 파라미터를 표시한다.
export component ParameterRow inherits Rectangle {
    in property <Control> control;
    in property <Translations> translations;
    in property <bool> enabled: true;
    // ID가 바뀌면 문구도 함께 다시 계산되는 바인딩이다. 외부에서 이 표시용 속성을 직접 조작하지 않는다.
    private property <ParameterText> copy: ParameterResources.describe(root.control.id, root.translations);
    callback changed(ParameterId, float);
    height: 91px;
    VerticalLayout {
        padding-top: 12px;
        spacing: 5px;
        HorizontalLayout {
            Label { text: root.copy.label; font-weight: 600; }
            // 보이는 숫자만 반올림한다. 슬라이더의 실제 값 보정과 단위 변환은 C++ 어댑터에서 처리한다.
            Label { text: round(root.control.value) + " " + root.copy.unit; color: Theme.accent; horizontal-alignment: right; }
        }
        Muted { text: root.copy.detail; }
        Slider {
            // 범위와 값은 컨트롤 모델에서 받는다. 같은 행 컴포넌트가 퍼센트/Hz/dB/ms 설정을 모두 표시할 수 있다.
            minimum: root.control.low;
            maximum: root.control.high;
            value: root.control.value;
            enabled: root.enabled;
            accessible-label: root.copy.label;
            // 현재 행 번호가 아니라 파라미터 ID와 새 값을 함께 보내 모델 순서 변경에도 같은 설정을 수정한다.
            changed(value) => { root.changed(root.control.id, value); }
        }
    }
}
