// 트레이의 출력 볼륨 설정 메뉴에서 여는 소형 창이다. 다른 화면과 같은 설정 값을 사용한다.
import { Theme } from "theme.slint";
import { Control, ParameterId } from "types.slint";
import { Translations } from "localization.slint";
import { ParameterRow } from "components/parameter-row.slint";

export component VolumeWindow inherits Window {
    in property <Translations> translations;
    title: root.translations.volume-title;
    width: 380px;
    height: 150px;
    background: Theme.window;
    default-font-family: Theme.font-family;
    default-font-size: Theme.body-size;
    in property <image> app-icon;
    icon: root.app-icon;
    in property <Control> control;
    callback parameter(ParameterId, float);
    callback dismiss;
    forward-focus: keys;
    keys := FocusScope {
        width: 100%; height: 100%;
        key-pressed(event) => {
            if event.text == Key.Escape { root.dismiss(); return accept; }
            reject
        }
        VerticalLayout {
            padding: 20px;
            ParameterRow {
                control: root.control;
                translations: root.translations;
                changed(id, value) => { root.parameter(id, value); }
            }
        }
    }
}
